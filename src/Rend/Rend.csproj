<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <RootNamespace>Rend</RootNamespace>
    <AssemblyName>Rend</AssemblyName>
    <Description>High-fidelity HTML-to-PDF/image rendering engine. Orchestrates HTML parsing, CSS cascade, layout, and output.</Description>
    <PackageId>Rend</PackageId>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- Define UNSAFE_SUPPORTED when AllowUnsafeBlocks is enabled -->
  <PropertyGroup Condition="'$(AllowUnsafeBlocks)' == 'true'">
    <DefineConstants>$(DefineConstants);UNSAFE_SUPPORTED</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Rend.Tests" />
    <InternalsVisibleTo Include="Rend.VisualRegression" />
    <InternalsVisibleTo Include="tmp-render" />
    <InternalsVisibleTo Include="tmp_pdftest" />
    <InternalsVisibleTo Include="Rend.Benchmarks" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Rend.Core\Rend.Core.csproj" />
    <ProjectReference Include="..\Rend.Html\Rend.Html.csproj" />
    <ProjectReference Include="..\Rend.Css\Rend.Css.csproj" />
    <ProjectReference Include="..\Rend.Pdf\Rend.Pdf.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="HarfBuzzSharp" Version="7.3.0.2" />
    <PackageReference Include="HarfBuzzSharp.NativeAssets.Linux" Version="7.3.0.2" />
    <PackageReference Include="SkiaSharp" Version="3.116.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="3.116.1" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Memory" Version="4.5.5" />
    <PackageReference Include="System.Buffers" Version="4.5.1" />
    <PackageReference Include="Microsoft.Bcl.HashCode" Version="1.1.1" />
  </ItemGroup>
</Project>
