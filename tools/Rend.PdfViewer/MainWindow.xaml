<Window x:Class="Rend.PdfViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rend PDF Viewer"
        Width="1100" Height="800"
        Background="{StaticResource BgDark}"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <Style x:Key="ToolbarButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource BgLight}" />
            <Setter Property="Foreground" Value="{StaticResource FgPrimary}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#505050" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource BgMid}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                Padding="10,6">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Open PDF" Style="{StaticResource AccentButton}"
                            Click="OpenFile_Click" Margin="0,0,12,0" />
                    <TextBlock x:Name="FileNameLabel" Text="" VerticalAlignment="Center"
                               Foreground="{StaticResource FgSecondary}" FontSize="13" Margin="0,0,16,0" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="DPI:" VerticalAlignment="Center"
                               Foreground="{StaticResource FgSecondary}" FontSize="13" Margin="0,0,4,0" />
                    <ComboBox x:Name="DpiCombo" Width="65" SelectedIndex="2"
                              SelectionChanged="DpiCombo_SelectionChanged"
                              Background="{StaticResource BgLight}" Foreground="{StaticResource FgPrimary}"
                              BorderBrush="{StaticResource BorderBrush}" FontSize="13">
                        <ComboBoxItem Content="72" />
                        <ComboBoxItem Content="96" />
                        <ComboBoxItem Content="150" />
                        <ComboBoxItem Content="200" />
                        <ComboBoxItem Content="300" />
                    </ComboBox>
                    <TextBlock Text="  Zoom:" VerticalAlignment="Center"
                               Foreground="{StaticResource FgSecondary}" FontSize="13" Margin="8,0,4,0" />
                    <Button Content="&#x2212;" Style="{StaticResource ToolbarButton}" Width="28"
                            Click="ZoomOut_Click" Margin="0,0,2,0" />
                    <TextBlock x:Name="ZoomLabel" Text="100%" VerticalAlignment="Center"
                               Foreground="{StaticResource FgPrimary}" FontSize="13"
                               Width="40" TextAlignment="Center" />
                    <Button Content="+" Style="{StaticResource ToolbarButton}" Width="28"
                            Click="ZoomIn_Click" Margin="2,0,0,0" />
                    <Button Content="Fit" Style="{StaticResource ToolbarButton}"
                            Click="ZoomFit_Click" Margin="6,0,0,0" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button x:Name="BtnPrev" Content="&#x25C0; Prev" Style="{StaticResource ToolbarButton}"
                            IsEnabled="False" Click="PrevPage_Click" Margin="0,0,6,0" />
                    <TextBlock x:Name="PageLabel" Text="" VerticalAlignment="Center"
                               Foreground="{StaticResource FgPrimary}" FontSize="13"
                               MinWidth="80" TextAlignment="Center" />
                    <Button x:Name="BtnNext" Content="Next &#x25B6;" Style="{StaticResource ToolbarButton}"
                            IsEnabled="False" Click="NextPage_Click" Margin="6,0,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="{StaticResource BgMid}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                Padding="10,4">
            <TextBlock x:Name="StatusLabel" Text="Drop a PDF or click Open PDF"
                       Foreground="{StaticResource FgSecondary}" FontSize="12" />
        </Border>

        <Grid>
            <TextBlock x:Name="DropOverlay"
                       Text="Drop a PDF file here"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontSize="20" Foreground="#444" />

            <ScrollViewer x:Name="PageScroller"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          Background="Transparent"
                          Visibility="Collapsed">
                <Border Padding="20" HorizontalAlignment="Center" VerticalAlignment="Top">
                    <Border Background="White">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="15" ShadowDepth="3" Opacity="0.5" />
                        </Border.Effect>
                        <Image x:Name="PageImage"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               Stretch="None" />
                    </Border>
                </Border>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
