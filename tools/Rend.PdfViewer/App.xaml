<Application x:Class="Rend.PdfViewer.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="BgDark" Color="#1e1e1e" />
        <SolidColorBrush x:Key="BgMid" Color="#2d2d2d" />
        <SolidColorBrush x:Key="BgLight" Color="#3c3c3c" />
        <SolidColorBrush x:Key="BorderBrush" Color="#555555" />
        <SolidColorBrush x:Key="FgPrimary" Color="#cccccc" />
        <SolidColorBrush x:Key="FgSecondary" Color="#888888" />
        <SolidColorBrush x:Key="AccentBrush" Color="#0078d4" />
    </Application.Resources>
</Application>
